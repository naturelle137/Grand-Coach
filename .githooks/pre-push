#!/usr/bin/env bash
# SPDX-License-Identifier: EUPL-1.2
# Activate with: git config core.hooksPath .githooks (docs/testing.md)
# Fast gate per pushed ref: lint, plus clippy and the fast tests of the
# packages affected since what the remote already has (or since origin/main
# for a new branch). CI runs everything (docs/testing.md).
set -euo pipefail
check="$(git rev-parse --show-toplevel)/scripts/check.sh"
zero=0000000000000000000000000000000000000000
while read -r _local_ref local_sha _remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue # branch deletion
    if [ "$remote_sha" = "$zero" ]; then
        base=origin/main
    else
        base=$remote_sha
    fi
    "$check" push --base "$base"
done
